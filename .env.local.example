# Local development only: PostgreSQL from compose.yaml.
# These are public demo credentials for a local-only database. Never reuse them
# for Supabase, Render, or any shared environment.
POSTGRES_DB=gestao_producao
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-admin-change-me
POSTGRES_HOST_PORT=55432

# The app connects from the Windows host to the local PostgreSQL container.
DB_URL=jdbc:postgresql://127.0.0.1:55432/gestao_producao
APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=local-runtime-change-me
# Locally Flyway uses the Compose postgres admin role.
MIGRATION_DB_USER=postgres
MIGRATION_DB_PASSWORD=local-admin-change-me

# Authentication remains managed by this project's Supabase Auth.
SUPABASE_JWT_ISSUER=https://clcgyhsjbenywugcagjo.supabase.co/auth/v1
SUPABASE_JWT_JWK_SET_URI=https://clcgyhsjbenywugcagjo.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=sb_publishable_9RUP4W_lqYsxaTV_6H1OLw_JgKkVwVr
SUPABASE_JWT_AUDIENCE=authenticated
SESSION_COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=local
PLATFORM_INVITATION_BASE_URL=http://localhost:8080

# Optional first-owner bootstrap: set only in a local ignored .env file.
# PLATFORM_BOOTSTRAP_OWNER_SUBJECT=
