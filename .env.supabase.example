# Hosted app (e.g. Render) -> managed Supabase PostgreSQL and Supabase Auth.
# Uses Supavisor shared session mode (IPv4, port 5432), suitable for a
# persistent Spring service. Replace both password placeholders in the host's
# secret manager; never commit real credentials.
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
APP_RUNTIME_USER=app_runtime.clcgyhsjbenywugcagjo
APP_RUNTIME_PASSWORD=__SET_APP_RUNTIME_PASSWORD_IN_RENDER__
MIGRATION_DB_USER=postgres.clcgyhsjbenywugcagjo
MIGRATION_DB_PASSWORD=__SET_SUPABASE_DATABASE_PASSWORD_IN_RENDER__

SUPABASE_JWT_ISSUER=https://clcgyhsjbenywugcagjo.supabase.co/auth/v1
SUPABASE_JWT_JWK_SET_URI=https://clcgyhsjbenywugcagjo.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=sb_publishable_9RUP4W_lqYsxaTV_6H1OLw_JgKkVwVr
SUPABASE_JWT_AUDIENCE=authenticated
SESSION_COOKIE_SECURE=true

# Optional: set this to the Supabase Auth user UUID for first PLATFORM_OWNER
# bootstrap. Keep the actual UUID in Render, not in this tracked example.
# PLATFORM_BOOTSTRAP_OWNER_SUBJECT=
